{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laboratorio-araujo",
  "main": "src/worker/index.mjs",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
    // O host não existe nas rotas de _redirects. O Worker precisa ver o pedido
    // antes do asset para o 301 do workers.dev estável. Não declare routes:
    // isso faria o Wrangler inferir workers_dev=false e derrubar o 301.
    "run_worker_first": true
  },
  // Obrigatório para `npx wrangler preview` no Wrangler 4.153. O bloco fica
  // vazio: assets, compatibilidade e o script permanecem no topo, em produção.
  "previews": {}
}
