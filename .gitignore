# dependências das ferramentas de qualidade (npm install recria)
node_modules/
# cache do Python
__pycache__/
*.pyc
# saída do build (recriada por: python -m scripts.build)
dist/
# cópia de referência para comparar saída do build (local, fora do Git)
dist-referencia/
.tools-bin/
# JS concatenado só para o ESLint (fonte = src/assets/js/modules/)
src/assets/js/main.js
# relatórios temporários
*.log
.lighthouse/
# tabela de preços original: fica só na cópia local, nunca no Git público
private/arquivo/
# capturas de tela de trabalho (algumas mostram a antiga tabela de preços)
screenshots/
# fotos ilustrativas antigas (removidas do repo; não reintroduzir)
_arquivo/
# Cloudflare Wrangler
.wrangler/
.dev.vars
