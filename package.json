{
  "name": "laboratorio-dental-araujo-site",
  "version": "2.2.0",
  "private": true,
  "description": "Site estático do Laboratório Dental Araújo (Belo Horizonte), gerado por Node.js e publicado prioritariamente na Cloudflare.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "serve": "node tools/serve.mjs 8766",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "lint:css": "stylelint \"src/assets/css/*.css\"",
    "lint:js": "node tools/lint-js.mjs",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "links": "linkinator http://127.0.0.1:8766 --recurse --skip \"^(?!http://127.0.0.1:8766)\"",
    "a11y": "node tools/a11y.mjs",
    "qa": "npm run build && npm run lint && node tools/qa-static.mjs",
    "qa:live": "node tools/qa-live.mjs",
    "links:externos": "linkinator http://127.0.0.1:8766 --recurse --skip \"^(?!http://127.0.0.1:8766|https://www\\.gandra\\.tech)\"",
    "migrate:static": "node tools/migrate-static-site.mjs",
    "images:prepare": "node tools/prepare-images.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "html-validate": "^9.0.0",
    "linkinator": "^6.1.0",
    "playwright": "^1.48.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "wrangler": "^4.153.0"
  }
}
